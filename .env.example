# Copy to .env beside start-server.ps1. Use KEY=value, one setting per line.
# The default URL belongs to the team's shared database. Use a separate database for development.
DB_URL=jdbc:mysql://localhost:3306/auction?serverTimezone=UTC
DB_USERNAME=auction_app
DB_PASSWORD=
JWT_SECRET=
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
# Optional: start-server.ps1 -Google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
