<?xml version="1.0" encoding="UTF-8"?>
<?import vn.edu.auction.client.I18n?>
<?import vn.edu.auction.client.ui.AppearanceControls?>
<?import vn.edu.auction.client.ui.UiIcon?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="vn.edu.auction.client.browse.BrowseController" styleClass="market-shell">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="12" styleClass="market-nav">
            <Label text="Bidora." styleClass="market-brand"/>
            <Label fx:id="previewNotice" I18n.caption="preview.notice" styleClass="preview-notice" visible="false" managed="false"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="manageButton" I18n.caption="seller.open" onAction="#handleManageItems" styleClass="nav-sell" visible="false" managed="false"><graphic><UiIcon kind="SELL"/></graphic></Button>
            <AppearanceControls/>
            <HBox fx:id="userArea" spacing="9" alignment="CENTER_RIGHT"/>
        </HBox>
    </top>
    <center>
        <ScrollPane fx:id="pageScroll" fitToWidth="true" hbarPolicy="NEVER" styleClass="market-scroll">
            <VBox spacing="24" styleClass="market-content">
                <fx:include fx:id="featured" source="featured-view.fxml"/>
                <TabPane fx:id="browseTabs" styleClass="market-tabs" tabClosingPolicy="UNAVAILABLE">
                    <tabs>
                        <Tab I18n.caption="browse.auctions"><graphic><UiIcon kind="AUCTION"/></graphic><content><fx:include fx:id="auctionList" source="auction-list-view.fxml"/></content></Tab>
                        <Tab I18n.caption="browse.items"><graphic><UiIcon kind="PRODUCT"/></graphic><content><fx:include source="item-list-view.fxml"/></content></Tab>
                    </tabs>
                </TabPane>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
