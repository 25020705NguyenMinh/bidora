<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<GridPane xmlns:fx="http://javafx.com/fxml/1" fx:id="hero" fx:controller="vn.edu.auction.client.browse.FeaturedController"
          styleClass="featured-panel" stylesheets="@../../css/featured.css" prefHeight="426" minHeight="400">
    <columnConstraints>
        <ColumnConstraints percentWidth="25"/>
        <ColumnConstraints percentWidth="24"/>
        <ColumnConstraints percentWidth="51"/>
    </columnConstraints>
    <rowConstraints><RowConstraints percentHeight="100"/></rowConstraints>
    <StackPane fx:id="imageFrame" minWidth="0" styleClass="featured-frame" GridPane.columnIndex="1" GridPane.columnSpan="2">
        <StackPane fx:id="imageLayers" mouseTransparent="true"/>
        <Region styleClass="featured-image-shade" mouseTransparent="true"/>
    </StackPane>
    <VBox alignment="CENTER_LEFT" spacing="24" minWidth="0" styleClass="featured-copy" GridPane.columnSpan="2" pickOnBounds="false">
        <VBox fx:id="copy" alignment="CENTER_LEFT" spacing="12" minWidth="0">
            <Label fx:id="context" styleClass="featured-context"/>
            <Label fx:id="title" styleClass="featured-title" wrapText="true" maxWidth="Infinity" minWidth="0" maxHeight="162"/>
            <Label fx:id="price" styleClass="featured-price" wrapText="true"/>
            <Label fx:id="description" styleClass="featured-description" wrapText="true" minWidth="0" maxWidth="350"/>
        </VBox>
        <Button fx:id="action" onAction="#openCurrent" styleClass="primary-button,featured-action" contentDisplay="RIGHT" graphicTextGap="12"/>
    </VBox>
    <HBox fx:id="thumbnails" alignment="BOTTOM_LEFT" spacing="6" GridPane.columnSpan="2" GridPane.valignment="BOTTOM"
          maxHeight="-Infinity" pickOnBounds="false" styleClass="featured-thumbnails"/>
    <VBox alignment="BOTTOM_RIGHT" spacing="8" GridPane.columnIndex="2" pickOnBounds="false">
        <padding><Insets right="24" bottom="22"/></padding>
        <Label fx:id="imageCredit" text="Ảnh minh họa" mouseTransparent="true" styleClass="featured-credit"/>
        <HBox alignment="CENTER" spacing="2" maxWidth="-Infinity" styleClass="featured-controls">
            <Button fx:id="previous" onAction="#previous" styleClass="featured-control"/>
            <Label fx:id="position" alignment="CENTER" styleClass="featured-position"/>
            <Button fx:id="next" onAction="#next" styleClass="featured-control"/>
            <Button fx:id="playback" onAction="#togglePlayback" styleClass="featured-control"/>
        </HBox>
    </VBox>
    <ProgressBar fx:id="dwellProgress" progress="0" GridPane.columnSpan="3" GridPane.valignment="BOTTOM"
                 maxWidth="Infinity" minHeight="3" prefHeight="3" maxHeight="3" mouseTransparent="true" styleClass="featured-time"/>
</GridPane>
