<?xml version='1.0' encoding='UTF-8'?>
<?import vn.edu.auction.client.I18n?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import vn.edu.auction.client.auth.AuthLayout?>

<AuthLayout xmlns:fx="http://javafx.com/fxml/1" fx:controller="vn.edu.auction.client.auth.AuthController">
    <form>
        <VBox spacing="18" styleClass="auth-form">
            <HBox alignment="CENTER_LEFT">
                <Label text="Bidora." styleClass="auth-wordmark" />
                <Region HBox.hgrow="ALWAYS" />
                <ComboBox fx:id="languageComboBox" styleClass="language-combo" />
            </HBox>
            <VBox spacing="6" styleClass="auth-heading">
                <Label I18n.caption="signupMethod.title" wrapText="true" styleClass="auth-heading-title" />
            </VBox>
            <Button maxWidth="Infinity" onAction="#handleGoogleLogin" styleClass="auth-social" I18n.caption="social.google">
                <graphic>
                    <ImageView fitHeight="19" fitWidth="19" preserveRatio="true">
                        <image>
                            <Image url="@../../icons/gglogo.png" />
                        </image>
                    </ImageView>
                </graphic>
            </Button>
            <HBox alignment="CENTER" spacing="10">
                <Separator HBox.hgrow="ALWAYS" />
                <Label I18n.caption="common.or" styleClass="footer-text" />
                <Separator HBox.hgrow="ALWAYS" />
            </HBox>
            <VBox spacing="6">
                <Label I18n.caption="email.label" styleClass="field-label" />
                <TextField fx:id="emailField" onAction="#handleEmailContinue" I18n.prompt="email.prompt" styleClass="input-field" />
                <Label fx:id="emailError" managed="false" visible="false" wrapText="true" styleClass="field-error" />
            </VBox>
            <Label fx:id="messageLabel" wrapText="true" styleClass="message-label" />
            <Button maxWidth="Infinity" defaultButton="true" onAction="#handleEmailContinue" I18n.caption="common.continue" styleClass="primary-button" />
            <Hyperlink I18n.caption="common.back" onAction="#openLoginView" styleClass="auth-link" />
        </VBox>
    </form>
</AuthLayout>
