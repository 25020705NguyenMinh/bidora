<?xml version='1.0' encoding='UTF-8'?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import vn.edu.auction.client.auth.AuthLayout?>

<AuthLayout xmlns:fx="http://javafx.com/fxml/1" fx:controller="vn.edu.auction.client.auth.AuthController">
    <form>
        <VBox spacing="18" styleClass="auth-form">
            <HBox alignment="CENTER_LEFT">
                <Label text="Bidora." styleClass="auth-wordmark" />
            </HBox>
            <VBox spacing="6" styleClass="auth-heading">
                <Label text="%password.forgot" styleClass="auth-heading-title" />
                <Label text="%reset.description" wrapText="true" styleClass="auth-heading-copy" />
            </VBox>
            <VBox spacing="6">
                <Label text="%email.label" styleClass="field-label" />
                <TextField fx:id="emailField" onAction="#handleConfirmReset" promptText="%email.prompt" styleClass="input-field" />
                <Label fx:id="emailError" managed="false" visible="false" wrapText="true" styleClass="field-error" />
            </VBox>
            <Label fx:id="messageLabel" wrapText="true" styleClass="message-label" />
            <Button fx:id="submitButton" defaultButton="true" text="%reset.send" onAction="#handleConfirmReset" maxWidth="Infinity" styleClass="primary-button" />
            <Hyperlink text="%reset.back" onAction="#openLoginView" styleClass="auth-link" />
        </VBox>
    </form>
</AuthLayout>
