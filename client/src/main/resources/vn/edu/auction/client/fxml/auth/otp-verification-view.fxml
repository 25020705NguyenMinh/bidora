<?xml version='1.0' encoding='UTF-8'?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import vn.edu.auction.client.auth.AuthLayout?>

<AuthLayout xmlns:fx="http://javafx.com/fxml/1" fx:controller="vn.edu.auction.client.auth.AuthController">
    <form>
        <VBox spacing="19" styleClass="auth-form">
            <HBox alignment="CENTER_LEFT">
                <Label text="Bidora." styleClass="auth-wordmark" />
                <Region HBox.hgrow="ALWAYS" />
                <ComboBox fx:id="languageComboBox" styleClass="language-combo" />
            </HBox>
            <VBox spacing="6" styleClass="auth-heading">
                <Label text="%otp.title" wrapText="true" styleClass="auth-heading-title" />
                <Label text="%otp.sentTo" styleClass="auth-heading-copy" />
                <Label fx:id="emailLabel" styleClass="field-label" />
            </VBox>
            <HBox spacing="8" alignment="CENTER_LEFT">
                <TextField fx:id="otp1" styleClass="otp-digit" />
                <TextField fx:id="otp2" styleClass="otp-digit" />
                <TextField fx:id="otp3" styleClass="otp-digit" />
                <TextField fx:id="otp4" styleClass="otp-digit" />
                <TextField fx:id="otp5" styleClass="otp-digit" />
                <TextField fx:id="otp6" styleClass="otp-digit" />
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="4">
                <Label text="%otp.noCode" styleClass="auth-heading-copy" />
                <Hyperlink fx:id="resendLink" text="%otp.resend" onAction="#onResend" styleClass="auth-link" />
                <Label fx:id="countdownLabel" styleClass="auth-heading-copy" />
            </HBox>
            <Label fx:id="messageLabel" wrapText="true" styleClass="message-label" />
            <Button fx:id="continueButton" defaultButton="true" maxWidth="Infinity" text="%common.continue" onAction="#onContinue" styleClass="primary-button" />
            <Hyperlink text="%common.back" onAction="#openLoginView" styleClass="auth-link" />
        </VBox>
    </form>
</AuthLayout>
