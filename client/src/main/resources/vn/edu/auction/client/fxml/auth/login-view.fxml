<?xml version='1.0' encoding='UTF-8'?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import vn.edu.auction.client.auth.AuthLayout?>

<AuthLayout xmlns:fx="http://javafx.com/fxml/1" fx:controller="vn.edu.auction.client.auth.AuthController">
    <form>
        <VBox spacing="15" styleClass="auth-form">
            <HBox alignment="CENTER_LEFT">
                <Label text="Bidora." styleClass="auth-wordmark" />
                <Region HBox.hgrow="ALWAYS" />
                <ComboBox fx:id="languageComboBox" styleClass="language-combo" />
            </HBox>
            <VBox spacing="5" styleClass="auth-heading">
                <Label text="%login.subtitle" wrapText="true" styleClass="auth-heading-title" />
                <Label text="%login.description" wrapText="true" styleClass="auth-heading-copy" />
            </VBox>
            <VBox spacing="6">
                <Label text="%email.label" styleClass="field-label" />
                <TextField fx:id="emailField" onAction="#handleLogin" promptText="%email.prompt" styleClass="input-field" />
                <Label fx:id="emailError" managed="false" visible="false" wrapText="true" styleClass="field-error" />
            </VBox>
            <VBox spacing="6">
                <Label text="%password.label" styleClass="field-label" />
                <HBox fx:id="passwordContainer" alignment="CENTER" styleClass="password-container">
                    <PasswordField fx:id="passwordField" onAction="#handleLogin" promptText="%password.prompt" styleClass="password-input" HBox.hgrow="ALWAYS" />
                    <TextField fx:id="passwordVisibleField" onAction="#handleLogin" promptText="%password.prompt" styleClass="password-input" managed="false" visible="false" HBox.hgrow="ALWAYS" />
                    <Button fx:id="togglePasswordButton" onAction="#togglePasswordVisibility" styleClass="eye-button" />
                </HBox>
                <Label fx:id="passwordError" managed="false" visible="false" wrapText="true" styleClass="field-error" />
            </VBox>
            <HBox alignment="CENTER_RIGHT">
                <Hyperlink onAction="#openResetPasswordView" text="%password.forgot" styleClass="auth-link" />
            </HBox>
            <Label fx:id="messageLabel" maxWidth="Infinity" wrapText="true" styleClass="message-label" />
            <Button fx:id="loginButton" defaultButton="true" text="%login.button" onAction="#handleLogin" maxWidth="Infinity" styleClass="primary-button" />
            <HBox alignment="CENTER" spacing="10">
                <Separator HBox.hgrow="ALWAYS" />
                <Label text="%common.or" styleClass="footer-text" />
                <Separator HBox.hgrow="ALWAYS" />
            </HBox>
            <Button text="%social.google" onAction="#handleGoogleLogin" maxWidth="Infinity" styleClass="auth-social">
                <graphic>
                    <ImageView fitHeight="19" fitWidth="19" preserveRatio="true">
                        <image>
                            <Image url="@../../icons/gglogo.png" />
                        </image>
                    </ImageView>
                </graphic>
            </Button>
            <HBox alignment="CENTER" spacing="4">
                <Label text="%login.noAccount" styleClass="footer-text" />
                <Hyperlink text="%login.createAccount" onAction="#openSignupMethodView" styleClass="auth-link" />
            </HBox>
        </VBox>
    </form>
</AuthLayout>
