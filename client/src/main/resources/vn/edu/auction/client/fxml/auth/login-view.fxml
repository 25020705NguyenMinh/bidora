<?xml version='1.0' encoding='UTF-8'?>
<?import vn.edu.auction.client.I18n?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import vn.edu.auction.client.auth.AuthLayout?>

<AuthLayout xmlns:fx="http://javafx.com/fxml/1" fx:controller="vn.edu.auction.client.auth.AuthController">
    <form>
        <VBox spacing="15" styleClass="auth-form">
            <HBox alignment="CENTER_LEFT">
                <Label text="Bidora." styleClass="auth-wordmark" />
                <Region HBox.hgrow="ALWAYS" />
                <ComboBox fx:id="languageComboBox" styleClass="language-combo" />
            </HBox>
            <VBox spacing="5" styleClass="auth-heading">
                <Label I18n.caption="login.subtitle" wrapText="true" styleClass="auth-heading-title" />
                <Label I18n.caption="login.description" wrapText="true" styleClass="auth-heading-copy" />
            </VBox>
            <VBox spacing="6">
                <Label I18n.caption="email.label" styleClass="field-label" />
                <TextField fx:id="emailField" onAction="#handleLogin" I18n.prompt="email.prompt" styleClass="input-field" />
                <Label fx:id="emailError" managed="false" visible="false" wrapText="true" styleClass="field-error" />
            </VBox>
            <VBox spacing="6">
                <Label I18n.caption="password.label" styleClass="field-label" />
                <HBox fx:id="passwordContainer" alignment="CENTER" styleClass="password-container">
                    <PasswordField fx:id="passwordField" onAction="#handleLogin" I18n.prompt="password.prompt" styleClass="password-input" HBox.hgrow="ALWAYS" />
                    <TextField fx:id="passwordVisibleField" onAction="#handleLogin" I18n.prompt="password.prompt" styleClass="password-input" managed="false" visible="false" HBox.hgrow="ALWAYS" />
                    <Button fx:id="togglePasswordButton" onAction="#togglePasswordVisibility" styleClass="eye-button" />
                </HBox>
                <Label fx:id="passwordError" managed="false" visible="false" wrapText="true" styleClass="field-error" />
            </VBox>
            <HBox alignment="CENTER_RIGHT">
                <Hyperlink onAction="#openResetPasswordView" I18n.caption="password.forgot" styleClass="auth-link" />
            </HBox>
            <Label fx:id="messageLabel" maxWidth="Infinity" wrapText="true" styleClass="message-label" />
            <Button fx:id="loginButton" defaultButton="true" I18n.caption="login.button" onAction="#handleLogin" maxWidth="Infinity" styleClass="primary-button" />
            <HBox alignment="CENTER" spacing="10">
                <Separator HBox.hgrow="ALWAYS" />
                <Label I18n.caption="common.or" styleClass="footer-text" />
                <Separator HBox.hgrow="ALWAYS" />
            </HBox>
            <Button I18n.caption="social.google" onAction="#handleGoogleLogin" maxWidth="Infinity" styleClass="auth-social">
                <graphic>
                    <ImageView fitHeight="19" fitWidth="19" preserveRatio="true">
                        <image>
                            <Image url="@../../icons/gglogo.png" />
                        </image>
                    </ImageView>
                </graphic>
            </Button>
            <HBox alignment="CENTER" spacing="4">
                <Label I18n.caption="login.noAccount" styleClass="footer-text" />
                <Hyperlink I18n.caption="login.createAccount" onAction="#openSignupMethodView" styleClass="auth-link" />
            </HBox>
        </VBox>
    </form>
</AuthLayout>
