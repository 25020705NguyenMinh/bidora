<?xml version='1.0' encoding='UTF-8'?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import vn.edu.auction.client.auth.AuthLayout?>

<AuthLayout xmlns:fx="http://javafx.com/fxml/1" fx:controller="vn.edu.auction.client.auth.AuthController">
    <form>
        <VBox spacing="16" styleClass="auth-form">
            <HBox alignment="CENTER_LEFT">
                <Label text="Bidora." styleClass="auth-wordmark" />
            </HBox>
            <VBox spacing="6" styleClass="auth-heading">
                <Label text="%reset.title" styleClass="auth-heading-title" />
                <Label text="%reset.requirements" wrapText="true" styleClass="auth-heading-copy" />
            </VBox>
            <VBox spacing="5">
                <Label text="%reset.password" styleClass="field-label" />
                <HBox fx:id="passwordContainer" alignment="CENTER" styleClass="password-container">
                    <PasswordField fx:id="passwordField" promptText="%reset.prompt" styleClass="password-input" HBox.hgrow="ALWAYS" />
                    <TextField fx:id="passwordVisibleField" promptText="%reset.prompt" managed="false" visible="false" styleClass="password-input" HBox.hgrow="ALWAYS" />
                    <Button fx:id="togglePasswordButton" onAction="#togglePasswordVisibility" styleClass="eye-button" />
                </HBox>
                <Label fx:id="passwordError" managed="false" visible="false" wrapText="true" styleClass="field-error" />
            </VBox>
            <VBox spacing="5">
                <Label text="%reset.confirm" styleClass="field-label" />
                <PasswordField fx:id="confirmPasswordField" promptText="%reset.confirm.prompt" styleClass="input-field" />
                <Label fx:id="confirmPasswordError" managed="false" visible="false" wrapText="true" styleClass="field-error" />
            </VBox>
            <Label fx:id="messageLabel" wrapText="true" styleClass="message-label" />
            <Button fx:id="submitButton" defaultButton="true" onAction="#handleResetPasswordSubmit" maxWidth="Infinity" styleClass="primary-button" text="%reset.update" />
            <Hyperlink onAction="#openLoginView" text="%reset.back" styleClass="auth-link" />
        </VBox>
    </form>
</AuthLayout>
