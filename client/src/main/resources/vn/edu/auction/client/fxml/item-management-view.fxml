<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?><?import javafx.scene.layout.*?>
<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="vn.edu.auction.client.controller.ItemManagementController" styleClass="market-shell">
 <top><HBox spacing="16" alignment="CENTER_LEFT" styleClass="market-nav"><Label text="Bidora." styleClass="market-brand"/><Region HBox.hgrow="ALWAYS"/><Button text="← Trở về khám phá" onAction="#handleBackToHome" styleClass="quiet-button"/></HBox></top>
 <center><VBox spacing="18" styleClass="management-page">
  <VBox spacing="5"><Label text="KHÔNG GIAN NGƯỜI BÁN" styleClass="section-kicker"/><Label text="Sản phẩm của bạn" styleClass="section-title"/><Label text="Thêm sản phẩm, theo dõi phê duyệt và tạo phiên đấu giá." styleClass="section-subtitle"/></VBox>
  <HBox spacing="18" VBox.vgrow="ALWAYS">
   <VBox spacing="14" styleClass="management-panel" HBox.hgrow="ALWAYS">
    <HBox alignment="CENTER_LEFT"><VBox spacing="4" HBox.hgrow="ALWAYS"><Label text="Danh sách sản phẩm" styleClass="management-title"/><Label text="Chọn một sản phẩm để chỉnh sửa hoặc tạo phiên." styleClass="section-subtitle"/></VBox><Button text="Tạo phiên đấu giá" onAction="#handleCreateAuction" styleClass="primary-button"/></HBox>
    <TableView fx:id="itemTable" VBox.vgrow="ALWAYS"><columns><TableColumn fx:id="idColumn" prefWidth="55" text="MÃ"/><TableColumn fx:id="nameColumn" prefWidth="160" text="SẢN PHẨM"/><TableColumn fx:id="descriptionColumn" prefWidth="180" text="MÔ TẢ"/><TableColumn fx:id="priceColumn" prefWidth="130" text="GIÁ KHỞI ĐIỂM"/><TableColumn fx:id="statusColumn" prefWidth="120" text="TRẠNG THÁI"/></columns></TableView>
    <Label fx:id="messageLabel" text="Sẵn sàng." wrapText="true" styleClass="message-label"/>
   </VBox>
   <VBox spacing="14" prefWidth="330" minWidth="300" styleClass="management-panel">
    <VBox spacing="4"><Label text="Thông tin sản phẩm" styleClass="management-title"/><Label text="Sản phẩm mới cần được phê duyệt." wrapText="true" styleClass="section-subtitle"/></VBox>
    <VBox spacing="6"><Label text="Tên sản phẩm" styleClass="field-label"/><TextField fx:id="nameField" promptText="Ví dụ: Máy ảnh Fujifilm"/></VBox>
    <VBox spacing="6"><Label text="Mô tả" styleClass="field-label"/><TextArea fx:id="descriptionArea" prefHeight="105" promptText="Tình trạng, thông số, phụ kiện đi kèm..." wrapText="true"/></VBox>
    <VBox spacing="6"><Label text="Giá khởi điểm (đ)" styleClass="field-label"/><TextField fx:id="startingPriceField" promptText="Nhập số tiền"/></VBox>
    <Button text="Thêm sản phẩm" onAction="#handleCreateItem" maxWidth="Infinity" styleClass="primary-button"/>
    <HBox spacing="8"><Button text="Cập nhật" onAction="#handleUpdateItem" HBox.hgrow="ALWAYS" maxWidth="Infinity"/><Button text="Xóa" onAction="#handleDeleteItem" styleClass="danger-button"/><Button text="Làm mới" onAction="#clearForm"/></HBox>
   </VBox>
  </HBox>
 </VBox></center>
</BorderPane>
