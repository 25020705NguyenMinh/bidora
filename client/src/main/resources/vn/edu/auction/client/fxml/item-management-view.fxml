<?xml version="1.0" encoding="UTF-8"?>
<?import vn.edu.auction.client.I18n?>
<?import vn.edu.auction.client.ui.AppearanceControls?>
<?import vn.edu.auction.client.ui.UiIcon?>
<?import javafx.scene.control.*?><?import javafx.scene.layout.*?>
<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="vn.edu.auction.client.controller.ItemManagementController" styleClass="market-shell">
 <top>
  <HBox spacing="16" alignment="CENTER_LEFT" styleClass="market-nav">
   <Label text="Bidora." styleClass="market-brand"/>
   <Region HBox.hgrow="ALWAYS"/>
   <AppearanceControls/>
   <Button I18n.caption="common.backExplore" onAction="#handleBackToHome" styleClass="quiet-button"><graphic><UiIcon kind="BACK"/></graphic></Button>
  </HBox>
 </top>
 <center>
  <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED">
   <content>
    <VBox spacing="18" styleClass="management-page">
     <VBox spacing="5">
      <Label fx:id="titleLabel" I18n.caption="seller.open" styleClass="section-title"/>
      <Label fx:id="subtitleLabel" I18n.caption="manage.intro" styleClass="section-subtitle"/>
     </VBox>
     <HBox spacing="18" VBox.vgrow="ALWAYS">
      <VBox spacing="14" styleClass="management-panel" HBox.hgrow="ALWAYS">
       <HBox alignment="CENTER_LEFT">
        <VBox spacing="4" HBox.hgrow="ALWAYS">
         <Label fx:id="tableTitleLabel" I18n.caption="manage.list" styleClass="management-title"/>
         <Label fx:id="tableSubtitleLabel" I18n.caption="manage.selectItem" styleClass="section-subtitle"/>
        </VBox>
        <Button fx:id="createAuctionButton" I18n.caption="manage.createAuction" onAction="#handleCreateAuction" styleClass="primary-button"><graphic><UiIcon kind="AUCTION"/></graphic></Button>
       </HBox>
       <HBox fx:id="filterBox" spacing="8" alignment="CENTER_LEFT" visible="false" managed="false">
        <Button fx:id="filterPendingBtn" I18n.caption="manage.pending" onAction="#handleFilterPending" styleClass="primary-button"/>
        <Button fx:id="filterUpcomingBtn" I18n.caption="manage.upcoming" onAction="#handleFilterUpcoming" styleClass="outline-button"/>
        <Button fx:id="filterActiveBtn" I18n.caption="manage.active" onAction="#handleFilterActive" styleClass="outline-button"/>
        <Button fx:id="filterAllBtn" I18n.caption="common.all" onAction="#handleFilterAll" styleClass="outline-button"/>
       </HBox>
       <TableView fx:id="itemTable" VBox.vgrow="ALWAYS">
        <columns>
         <TableColumn fx:id="idColumn" prefWidth="55" I18n.caption="table.id"/>
         <TableColumn fx:id="sellerColumn" prefWidth="95" I18n.caption="table.seller"/>
         <TableColumn fx:id="nameColumn" prefWidth="160" I18n.caption="table.item"/>
         <TableColumn fx:id="descriptionColumn" prefWidth="180" I18n.caption="table.description"/>
         <TableColumn fx:id="priceColumn" prefWidth="130" I18n.caption="table.startingPrice"/>
         <TableColumn fx:id="statusColumn" prefWidth="135" I18n.caption="table.status"/>
        </columns>
       </TableView>
       <Label fx:id="messageLabel" I18n.caption="common.ready" wrapText="true" styleClass="message-label"/>
      </VBox>
      <VBox spacing="14" prefWidth="340" minWidth="300" styleClass="management-panel">
       <VBox spacing="4">
        <Label fx:id="formTitleLabel" I18n.caption="manage.itemDetails" styleClass="management-title"/>
        <Label fx:id="formSubtitleLabel" I18n.caption="manage.newReview" wrapText="true" styleClass="section-subtitle"/>
       </VBox>
       <StackPane fx:id="productPhoto" minHeight="140" prefHeight="140"/>
       <HBox spacing="8">
        <Button fx:id="chooseImageButton" I18n.caption="product.chooseImage" onAction="#chooseImage"><graphic><UiIcon kind="UPLOAD"/></graphic></Button>
        <Button fx:id="removeImageButton" I18n.caption="product.removeImage" onAction="#removeImage"><graphic><UiIcon kind="DELETE"/></graphic></Button>
       </HBox>
       <VBox spacing="6">
        <Label I18n.caption="manage.name" styleClass="field-label"/>
        <TextField fx:id="nameField" I18n.prompt="manage.nameExample"/>
       </VBox>
       <VBox spacing="6">
        <Label I18n.caption="manage.description" styleClass="field-label"/>
        <TextArea fx:id="descriptionArea" prefHeight="95" I18n.prompt="manage.descPrompt" wrapText="true"/>
       </VBox>
       <VBox spacing="6">
        <Label I18n.caption="manage.price" styleClass="field-label"/>
        <TextField fx:id="startingPriceField" I18n.prompt="manage.pricePrompt"/>
       </VBox>
       <VBox fx:id="feedbackBox" spacing="6" visible="false" managed="false">
        <Label I18n.caption="manage.feedback" styleClass="field-label"/>
        <TextArea fx:id="feedbackArea" prefHeight="80" I18n.prompt="manage.feedbackPrompt" wrapText="true"/>
       </VBox>
       <Button fx:id="createItemButton" I18n.caption="manage.add" onAction="#handleCreateItem" maxWidth="Infinity" styleClass="primary-button"><graphic><UiIcon kind="PLUS"/></graphic></Button>
       <Button fx:id="approveButton" I18n.caption="manage.approve" onAction="#handleApproveItem" maxWidth="Infinity" styleClass="primary-button" visible="false" managed="false"><graphic><UiIcon kind="CHECK"/></graphic></Button>
       <Button fx:id="rejectButton" I18n.caption="manage.reject" onAction="#handleRejectItem" maxWidth="Infinity" styleClass="outline-button" visible="false" managed="false"><graphic><UiIcon kind="CLOSE"/></graphic></Button>
       <FlowPane fx:id="bottomActionRow" hgap="8" vgap="8">
        <Button fx:id="updateButton" I18n.caption="common.update" onAction="#handleUpdateItem" HBox.hgrow="ALWAYS" maxWidth="Infinity"><graphic><UiIcon kind="SAVE"/></graphic></Button>
        <Button fx:id="deleteButton" I18n.caption="common.delete" onAction="#handleDeleteItem" styleClass="danger-button"><graphic><UiIcon kind="DELETE"/></graphic></Button>
        <Button fx:id="clearButton" I18n.caption="common.refresh" onAction="#clearForm"><graphic><UiIcon kind="HISTORY"/></graphic></Button>
       </FlowPane>
      </VBox>
     </HBox>
    </VBox>
   </content>
  </ScrollPane>
 </center>
</BorderPane>
